# SpeakBuddy Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# ==========================================
# 1. Local Open-Source LLM (Ollama)
# ==========================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT_SECONDS=120.0

# ==========================================
# 2. Local Open-Source Speech Recognition
# ==========================================
WHISPER_MODEL_SIZE=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ==========================================
# 3. Local SQLite Database
# ==========================================
DATABASE_PATH=speakbuddy.db
